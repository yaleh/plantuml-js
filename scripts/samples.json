{
  "$comment": "Multi-scale layout samples. `source` is a file name under tests/fixtures (or, with --manifest <archguard-output-dir>, the same file name found in that directory / its class/ and overview/ subdirs). `view` applies a renderer view; `packagesMatching` keeps only the packages whose id matches the regex (and their entities / inter-entity relations). `thresholds` map a metrics field to {min,max}; the harness exit code follows them.",
  "tiers": {
    "S": "<= 25 entities",
    "M": "25-70 entities",
    "L": "100-200 entities",
    "XL": "all-classes (660 entities)"
  },
  "samples": [
    {
      "id": "s-class",
      "tier": "S",
      "source": "archguard-class.puml",
      "thresholds": {
        "edgeFlushCount": { "max": 0 },
        "edgeNodeIntersections": { "max": 0 },
        "aspectRatio": { "min": 0.6, "max": 2.2 },
        "areaUtilization": { "min": 0.25 }
      }
    },
    {
      "id": "s-architecture-manual",
      "tier": "S",
      "source": "archguard-architecture-manual.puml",
      "thresholds": {
        "edgeNodeIntersections": { "max": 0 },
        "aspectRatio": { "min": 0.6, "max": 2.2 },
        "areaUtilization": { "min": 0.25 }
      }
    },
    {
