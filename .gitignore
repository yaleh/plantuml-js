# quay runtime state (generated by the loop — .quay/config.yml + .quay/profiles.yml stay tracked)
.quay/*
!.quay/config.yml
!.quay/profiles.yml
# quay runtime artifacts outside .quay/ (written by quay itself; list = plugin/scripts/quay-runtime-artifacts.txt — do NOT hand-edit, add to that manifest)
.workflow-events/
orchestration/inner-idle-log.jsonl
orchestration/manager-tick-log.md
orchestration/tick-log.md
milestones/fast-mode-telemetry/*.json
orchestration/dispatch-record.jsonl
orchestration/semantic-face-dispatch-record.jsonl
orchestration/manager-pending.md
**/.quay-parse-cache.json
goals/*.lock
adr/*.lock
docs-managed/*.lock
meta/*.lock

# Node.js build/dependency state (project-owned, below the quay-managed block)
node_modules/
dist/
*.tsbuildinfo

# local inspection renders (generated on demand, not shipped)
rendered/*
!rendered/metrics.baseline.json

# demo generated artifacts (rebuilt by scripts/build-demo.mjs)
examples/archguard-data.js
examples/demo.bundle.js
