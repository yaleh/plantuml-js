{
  "name": "@yalehwang/plantuml-js",
  "version": "0.3.0",
  "description": "Pure-TypeScript PlantUML class diagram renderer (MIT)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaleh/plantuml-js.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elk": {
      "types": "./dist/elk.d.ts",
      "import": "./dist/elk.js"
    },
    "./archguard": {
      "types": "./dist/archguard.d.ts",
      "import": "./dist/archguard.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "demo:build": "node scripts/build-demo.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && node scripts/check-dist-clean.mjs"
  },
  "dependencies": {
    "@viz-js/viz": "^3.31.0",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
